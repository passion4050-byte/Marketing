# ─── LLM Provider ───────────────────────────────────────────────
# stub      = 미리 작성된 의료법 안전 FAQ 반환 (키 0개, 즉시 동작)
# gemini    = Google Gemini Flash (무료, https://aistudio.google.com/apikey)
# anthropic = Claude (유료, https://console.anthropic.com)
# openai    = GPT (유료, https://platform.openai.com)
LLM_PROVIDER=stub

# 키는 LLM_PROVIDER가 stub이 아닐 때만 필요
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Storage ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/geo.db

# ─── Cost Guardrail (정의서 §6) ────────────────────────────────
MAX_DAILY_USD=10.0
MAX_CONTENT_GEN_PER_DAY=50

# ─── Future (RAG/측정 — Phase 3+) ──────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=./data/chroma
PERPLEXITY_API_KEY=
DEFAULT_N_SAMPLES=30
DEFAULT_CONCURRENCY=5

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
