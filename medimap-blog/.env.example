# Public site origin (used in canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL=https://medimap.kr

# Set to "/blog" if deployed as a subpath (e.g., medimap.kr/blog).
# Leave empty when deployed at root (e.g., blog.medimap.kr or medimap.kr).
NEXT_PUBLIC_BASE_PATH=

# 단축도메인 redirect 베이스 (UTM 부착 후 m.medimap.kr/r/{slug}로 클릭 추적)
NEXT_PUBLIC_SHORTLINK_BASE=https://m.medimap.kr/r

# GA4 measurement ID — Phase 8-02 (gtag.js 직접 로드). GTM 사용 시 비워둠.
NEXT_PUBLIC_GA_ID=

# GTM container ID — Phase 8-02 (Tag Manager 통한 GA4/Meta Pixel/네이버 통합 관리)
# GTM 과 GA4 measurement 둘 다 설정하면 GTM 우선
NEXT_PUBLIC_GTM_ID=

# 카톡 채널 / 네이버 플레이스 / 전화 — CTA 블록에서 사용
NEXT_PUBLIC_KAKAO_CHANNEL_URL=https://pf.kakao.com/_xxxxx
NEXT_PUBLIC_NAVER_PLACE_URL=https://map.naver.com/v5/search/메디맵
NEXT_PUBLIC_PHONE=02-0000-0000

# Phase 8-03 — Supabase Postgres 직결 (서버 전용, NEXT_PUBLIC_ 접두 *없이*).
# 단축링크 click 을 shortlinks/shortlink_clicks 테이블에 직접 INSERT.
# Supabase pooler URL 권장: postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# IP 익명화 salt (DATABASE_URL 사용 시 ip_hash 생성에 사용. 비워두면 기본값 사용)
IP_HASH_SALT=

# (선택) 외부 click webhook — DATABASE_URL 가 있으면 보통 불필요
SHORTLINK_CLICK_WEBHOOK=
SHORTLINK_WEBHOOK_SECRET=
