# Public site origin (used in canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL=https://medimap.kr

# Set to "/blog" if deployed as a subpath (e.g., medimap.kr/blog).
# Leave empty when deployed at root (e.g., blog.medimap.kr or medimap.kr).
NEXT_PUBLIC_BASE_PATH=

# 단축도메인 redirect 베이스 (UTM 부착 후 m.medimap.kr/r/{slug}로 클릭 추적)
NEXT_PUBLIC_SHORTLINK_BASE=https://m.medimap.kr/r

# GA4 measurement ID (선택)
NEXT_PUBLIC_GA_ID=

# 카톡 채널 / 네이버 플레이스 / 전화 — CTA 블록에서 사용
NEXT_PUBLIC_KAKAO_CHANNEL_URL=https://pf.kakao.com/_xxxxx
NEXT_PUBLIC_NAVER_PLACE_URL=https://map.naver.com/v5/search/메디맵
NEXT_PUBLIC_PHONE=02-0000-0000
