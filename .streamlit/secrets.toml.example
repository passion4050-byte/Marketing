# Streamlit Community Cloud Secrets 템플릿.
#
# 사용법:
# 1. 이 파일을 복사해 .streamlit/secrets.toml 로 저장 (gitignored — 커밋되지 않음)
# 2. 로컬 테스트용으로만 사용 (Streamlit Cloud 에서는 웹 UI에 직접 입력)
# 3. Streamlit Cloud → App settings → Secrets 에 동일한 형식으로 붙여넣기

# ── LLM Provider ───────────────────────────────────────────────
# stub | gemini | anthropic | openai
LLM_PROVIDER = "gemini"

# Gemini (Google AI Studio — 무료): https://aistudio.google.com/apikey
GOOGLE_API_KEY = "여기에_본인_Gemini_키_붙여넣기"

# (선택) 다른 프로바이더
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."

# ── 비밀번호 게이트 ────────────────────────────────────────────
# 공개 URL을 받게 되므로 데모/내부 사용자만 접근하도록 제한.
# 빈 문자열이면 게이트 비활성 (누구나 접근 가능 — 권장하지 않음).
APP_PASSWORD = "여기에_데모용_비밀번호_설정"

# ── 비용 가드레일 (선택) ──────────────────────────────────────
# 일일 LLM 호출 한도 — 기본값은 src/content/llm.py 참조
# MAX_DAILY_USD = "1.0"
# MAX_CONTENT_GEN_PER_DAY = "50"
