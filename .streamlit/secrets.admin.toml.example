# blogkey-adm (메디맵 직원 전용 어드민) Streamlit Cloud Secrets 템플릿.
# Phase 9-04 — admin_app.py 를 entry point 로 하는 별도 Cloud 앱 전용.
#
# 사용법:
# 1. share.streamlit.io → New app → Repo=passion4050-byte/Marketing,
#    Branch=main, Main file path=admin_app.py, App URL=blogkey-adm
# 2. Advanced → Python 3.12
# 3. Deploy 클릭
# 4. 첫 빌드 후 Settings → Secrets 탭에 ↓ 내용을 그대로 붙여넣고 Save
# 5. App reboot — 1~2분 후 https://blogkey-adm.streamlit.app 라이브
#
# ⚠️ 절대 깃에 커밋 금지. 이 파일은 example 만 트래킹.

# ── 어드민 게이트 (★ 필수 — blogkey 와 다른 비밀번호 권장) ──────
ADMIN_APP_PASSWORD = "여기에_어드민용_강력한_비밀번호"

# ── DB (★ 필수 — blogkey.streamlit.app 과 동일한 Supabase URL) ──
# 같은 DB 를 공유해야 어드민이 발급한 password_hash 를 blogkey 가 verify 가능.
DATABASE_URL = "postgresql://postgres.xxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"

# ── LLM Provider (어드민에서도 콘텐츠 생성 가능 — blogkey 와 동일 키 OK) ──
LLM_PROVIDER = "gemini"
GOOGLE_API_KEY = "여기에_Gemini_키"
# (선택) 백업 프로바이더
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."

# ── GA4 Data API (선택 — 🔄 Funnel 탭에서 자사 URL pageview 표시) ──
# 미설정 시 Funnel 탭이 cite × click 만 표시 (pageview 컬럼 숨김).
GA4_PROPERTY_ID = "6353278443"
# Service Account JSON 전체를 한 줄 문자열로 (큰따옴표 안에서 \n 은 \\n 로 escape)
GA4_SERVICE_ACCOUNT_JSON = '{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# ── 비용 가드레일 (선택, 글로벌 — 모든 테넌트 합산) ──────────────
MAX_DAILY_USD = "10.0"
MAX_CONTENT_GEN_PER_DAY = "200"
